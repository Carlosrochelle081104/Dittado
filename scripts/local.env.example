# Configurações locais de compilação e identidade (NÃO versionado / no .gitignore)
# Copie para scripts/local.env e configure conforme o seu ambiente.

# Bundle Identifier do aplicativo macOS (padrão neutro para open source: app.dittado.Dittado)
DITTADO_BUNDLE_ID="app.dittado.Dittado"

# Nome do certificado de assinatura de código no Keychain (ex: "Dittado Dev" ou "-" para ad-hoc)
DITTADO_SIGN_IDENTITY="Dittado Dev"
